QStatusBar{
    background: #f3f3f3;
}

QPushButton#border{
    border-radius: 5px;
    padding: 8px;
    border-right: 2px solid #888888;
    border-bottom: 2px solid #888888;
    border-left: 1px solid #ffffff;
    border-top: 1px solid #ffffff;
}

QPushButton#flat:hover {
}

QPushButton#border:hover {
    background-color: lightgray;
}

QMessageBox QPushButton{
    background-color: rgb(250,252,253);
    border-radius: 5px;
    padding: 8px;
    border-right: 2px solid #888888;
    border-bottom: 2px solid #888888;
    border-left: 1px solid #ffffff;
    border-top: 1px solid #ffffff;
}

QPushButton{
    background-color: rgb(238,244,249);
    border-radius: 5px;
    padding: 8px;
}

QPushButton:hover {
    background-color: lightgray;
}
QWidget{
    background-color: #f7f7f7;
    color:black;
}

QListWidget, QListView, QTreeWidget, QTreeView {
    outline: 0px;
}

QMenu::item:selected {
      color: black;
      background: rgb(230, 235, 240);
}

QListWidget {
    color: black;
    border:none;
}
QListWidget::item{
    margin:5px;
}
QListWidget::item:hover {
    margin:5px;
    background: #eaeaea;
}

QListWidget::item:selected {
    margin:5px;
    background: #e4e4e4;
    color: black;
    font-weight: bold;
}
QListWidget::item:selected:hover {
    background-color: #D3D3D3;
}

QListView {
    color: black;
    border:none;
}
QListView::item{
    margin:5px;
}
QListView::item:hover {
    margin:5px;
    background: #eaeaea;
}
QListView::item:selected {
    margin:5px;
    background: #e4e4e4;
    color: black;
    font-weight: bold;
}

HistoryPanel::item:hover {
    background: rgb(52, 52, 52);
}

QCheckBox::indicator {
    background: rgb(255, 255, 255);
    Width:20px;
    Height:20px;
    border-radius: 10px
}
QCheckBox::indicator:unchecked{
    Width:20px;
    Height:20px;
    image: url(:/icons/resources/icons/unselect.svg);
}
QCheckBox::indicator:checked{
    Width:20px;
    Height:20px;
    image: url(:/icons/resources/icons/select.svg);
}
QScrollBar:vertical {
    border-width: 0px;
    border: none;
    background:rgba(133, 135, 138, 0);
    width:6px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop: 0 rgb(133, 135, 138), stop: 0.5 rgb(133, 135, 138), stop:1 rgb(133, 135, 138));
    min-height: 20px;
    max-height: 20px;
    margin: 0 0px 0 0px;
    border-radius: 3px;
}
QScrollBar::add-line:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop: 0 rgba(133, 135, 138, 0), stop: 0.5 rgba(133, 135, 138, 0),  stop:1 rgba(133, 135, 138, 0));
    height: 0px;
    border: none;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop: 0  rgba(133, 135, 138, 0), stop: 0.5 rgba(133, 135, 138, 0),  stop:1 rgba(133, 135, 138, 0));
    height: 0 px;
    border: none;
    subcontrol-position: top;
    subcontrol-origin: margin;
}
QScrollBar::sub-page:vertical {
    background: rgba(133, 135, 138, 0);
}

QScrollBar::add-page:vertical {
    background: rgba(133, 135, 138, 0);
}
QProgressBar{
    font-family: 'Arial Unicode MS';
    height:22px;
    text-align:center;
    font-size:14px;
    color:black;
    border-radius:11px;
    background:#EBEEF5;
}
QProgressBar::chunk{
    border-radius:11px;
    background:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #99ffff,stop:1 #9900ff);
}
QComboBox
{
    border-radius:3px;
    border:2px solid rgb(230, 235, 240);
    padding-top: 2px;
    padding-left: 2px;
}
QComboBox:disabled
{
    background-color:rgba(50,50,50,200);
    color:rgb(160,160,160);
}
QComboBox:hover
{
    background-color:rgba(230,230,230,200);
    border:1px solid rgb(31,156,220) ;
}

QComboBox::drop-down
{
    border:none;
}

QComboBox::down-arrow
{
    right:0px;
    width: 16px;
    height: 16px;
    image: url(:/icons/resources/icons/down.svg);
}
QComboBox::down-arrow:on
{
    width: 16px;
    height: 16px;
    image: url(:/icons/resources/icons/up.svg);
}
QLineEdit
{
    background:transparent;
    border-radius:5px;
    background-color:#EAEAEA;
}

QTabBar::tab {
    background-color:  rgb(238,244,249);
    color: black;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: rgb(230, 235, 240);
}

QTabWidget::pane {
    border: 0;
}

QSpinBox::up-button,QDoubleSpinBox::up-button{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    height: 20px;
    image: url(':/icons/resources/icons/sub.svg');
}

QSpinBox::down-button,QDoubleSpinBox::down-button{
    subcontrol-origin: padding;
    subcontrol-position: bottom left;
    width: 20px;
    height: 20px;
    image: url(':/icons/resources/icons/min.svg');
}

QSpinBox:up-button:pressed,QDoubleSpinBox:up-button:pressed{
    margin-top:4px;
}

QSpinBox:down-button:pressed,QDoubleSpinBox:down-button:pressed{
    margin-top:4px;
}

QSpinBox:hover,QDoubleSpinBox:hover {
    background-color: lightgrey;
}

QSpinBox,QDoubleSpinBox {
    border-radius: 0px;
    border:2px solid rgb(230, 235, 240);
    background-color:rgb(230, 235, 240);
	font-size: 9pt;
}

QSlider::groove:horizontal{
		height: 12px;
		left: 0px;
		right: 0px;
		border:0px;
	    border-radius:6px;
		background:rgba(0,0,0,50);
 }
QSlider::handle:horizontal{
		width:  24px;
		height: 24px;
		margin-top: -6px;
		margin-left: 0px;
		margin-bottom: -6px;
		margin-right: 0px;
		border-image:url(:/icons/resources/icons/dot.svg);
}
QSlider::sub-page:horizontal{
	   background:rgba(80,166,234,1);
}

#setting-container{
    background-color:rgb(251,251,251);
    border-radius: 10px;
}

QTreeWidget {
    border: none;
    background-color: #f7f7f7;
    font-size: 14px;
    padding: 5px;
}

QTreeWidget::item {
    padding: 10px;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    margin-bottom: 5px;
    background-color: #ffffff;
}

QTreeWidget::item:hover {
    background-color: #e0e0e0;
}

QTreeWidget::item:selected {
    background-color: #84C1FF;
    color: white;
}

QTreeWidget::item:!selected:hover {
    background-color: #d0e6f4;
}


QHeaderView::section {
    background-color: #333;
    color: white;
    padding: 5px;
    font-size: 16px;
}


QHeaderView::section:checked {
    background-color: #666;
}


QPushButton#label_group_num {
    background-color: #f7f7f7;
    color:#808080;
    margin-right:6px;
    text-align: right
}

QPushButton#label_group_num:hover {
    background-color: #f7f7f7;
}

QWidget#contact_tree{
    background: #f7f7f7;
    border-radius: 0px;
}

QFrame#contact_tree{
    background: #f7f7f7;
    border-right: 1px solid  rgb(227,228,222);
}

QFrame#contact_tree{
    background: #f7f7f7;
    border-right: 1px solid  rgb(227,228,222);
}

QMenu#tool_menu {
    background-color: white;
    border: 2px solid #e1e1e1;
    border-radius: 5px;
    padding: 8px;
}

QFrame#frame_chat{
    border-bottom: 1px solid rgb(225,225,225);
}

/* 聊天界面中间部分的边框 */
QFrame#frame_chat_border{
    background: #f7f7f7;
    border-right: 1px solid  rgb(227,228,222);
    border-top: 0px solid  rgb(227,228,222);
    border-bottom: 0px solid  rgb(227,228,222);
    border-right: 1px solid  rgb(227,228,222);
}

/* 消息发送按钮 */
QPushButton#btn_chat_sender{
    background-color: #e9e9e9;
    border-radius: 5px;
    padding: 8px;
}
QPushButton#btn_chat_sender:hover {
    background-color: lightgray;
}

QCommandLinkButton{
    background-color: #f7f7f7;
    color: black;
}

QCommandLinkButton:hover{
    background-color: lightgray;
    color: black;
}

/* 聊天消息 */
QLabel#bubble-message-send{
    background-color:#95ec69;
    border-radius:5px;
    padding:5px;
}

QLabel#bubble-message-receive{
    background-color:#ffffff;
    border-radius:5px;
    padding:5px;
}

QLabel#bubble-message-quote{
    background-color:rgb(231,231,231);
    border-radius:5px;
    padding:5px;
}

QLabel#bubble-message-notice{
    padding: 10px;
    color: rgb(68,68,68);
}

QWidget#bubble-message-voice-send{
    background-color:#95ec69;
    border-radius:5px;
    padding:5px;
}

QLabel#bubble-message-voice-send{
    border-radius:0px;
    padding:0px;
}

QWidget#bubble-message-voice-receive{
    background-color:#ffffff;
    border-radius:5px;
    padding:5px;
}

QLabel#bubble-message-voice-receive{
    border-radius:0px;
    padding:0px;
}

QLabel#bubble-message-nickname{
    color: rgb(68,68,68);
}

/* SideBar */


QWidget#Sidebar {
    border-right: 1px solid  rgb(227,228,226);
}
QWidget#SidebarItem {
    background-color: #f7f7f7;
}
QWidget#SidebarItem:hover {
    background-color: #ededed;
}

QListWidget#listWidgetSidebar {
    border:none;
}

/* 列表项通用样式 */
QListWidget#listWidgetSidebar::item {
    height: 60px;
}

QPushButton#SideBar {
    height: 60px;
    background-color: #f7f7f7;
    border-radius: 0px;
    padding: 0px 4px;
    border: none;
    text-align: left;
}

QPushButton#SideBar:hover {
    background-color: #ededed;
    border:none;
}
/* SideBar End */